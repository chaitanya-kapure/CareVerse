# ---------------------------------------------------------------------------
# CAREVERSE server environment
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careverse

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot with the placeholder value when ENVIRONMENT=production.
JWT_SECRET_KEY=change_this_in_development
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File storage (Phase 2) ------------------------------------------------
# "local" writes to STORAGE_LOCAL_PATH. Swap to an S3/Cloudinary driver later
# without changing any calling code.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
MAX_UPLOAD_MB=15
# Comma-separated allowlist. MVP accepts PDF only (spec section 3).
ALLOWED_MIME_TYPES=application/pdf

# --- AI summarization (Phase 3) -------------------------------------------
# Leave AI_API_KEY empty to run the deterministic mock summarizer, which keeps
# the demo working offline. Setting a key switches the provider on at runtime.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# --- Password reset (OTP) --------------------------------------------------
# Tunables, not secrets. The 6-digit code itself is generated per request,
# hashed, and never written anywhere in plaintext.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Wrong codes allowed per issued OTP before it is destroyed.
OTP_MAX_ATTEMPTS=5
# Minimum gap between two OTPs for the same address.
OTP_RESEND_COOLDOWN_SECONDS=60
# Lifetime of the single-use token handed out after a correct OTP.
RESET_TOKEN_TTL_MINUTES=10

# --- Email -----------------------------------------------------------------
# "mock"  prints the OTP to the server log (development only)
# "smtp"  sends a real message
# "gmail" reserved for a Gmail API client; not implemented yet
#
# The app refuses to boot with EMAIL_PROVIDER=mock when ENVIRONMENT=production,
# because that log line is a live credential.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@careverse.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Supply through your environment or a secrets manager. Never commit a value.
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=15
