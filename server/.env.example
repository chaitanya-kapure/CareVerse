# ---------------------------------------------------------------------------
# CAREVERSE server environment
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.
# ---------------------------------------------------------------------------

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careverse

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot with the placeholder value when ENVIRONMENT=production.
JWT_SECRET_KEY=change_this_in_development
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File storage (Phase 2) ------------------------------------------------
# "local" writes to STORAGE_LOCAL_PATH. Swap to an S3/Cloudinary driver later
# without changing any calling code.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
MAX_UPLOAD_MB=15
# Comma-separated allowlist. MVP accepts PDF only (spec section 3).
ALLOWED_MIME_TYPES=application/pdf

# --- AI summarization (Phase 4C) ------------------------------------------
# AI_PROVIDER selects the summary provider:
#   mock   deterministic summary assembled from the extracted data. No language
#          model is called and no medical text leaves this machine. This is the
#          default, and it is also the automatic fallback if a real provider
#          fails at runtime (timeout, 429, 5xx) -- in which case the summary is
#          stored with is_mock=true and the UI shows the demo label.
#   openai any OpenAI-compatible chat-completions endpoint, called once per
#          summary over plain httpx with a JSON response format.
#
# Leaving this as mock is a fully supported way to run the app: no account, no
# key, no external call. Naming a provider this build does not implement (such
# as anthropic) is a refusal, not a degradation -- the request fails with 503
# SUMMARY_PROVIDER_UNAVAILABLE rather than quietly serving something no model
# produced.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=openai. Supply through your environment or a
# secrets manager; never commit a real value. With the provider set to openai
# and this empty, the app answers 503 naming the missing variable rather than
# forwarding an unauthenticated request to a third party. This key is read
# only by the server: it is never returned in an API response, never logged,
# and never included in the client bundle.
AI_API_KEY=
# Any model your endpoint serves. Checked at the switch point, not defaulted at
# call time -- this build will not choose which model reads a patient's records.
AI_MODEL=gpt-4o-mini
# Base URL; "/chat/completions" is appended here. Point this at a self-hosted or
# proxied endpoint to keep extracted medical text inside your own infrastructure.
AI_BASE_URL=https://api.openai.com/v1
# Finite and required. A request with no timeout would hold a thread on a
# summary that carries a patient's records, so a non-positive value is refused.
AI_TIMEOUT_SECONDS=30

# --- Password reset (OTP) --------------------------------------------------
# Tunables, not secrets. The 6-digit code itself is generated per request,
# hashed, and never written anywhere in plaintext.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
# Wrong codes allowed per issued OTP before it is destroyed.
OTP_MAX_ATTEMPTS=5
# Minimum gap between two OTPs for the same address.
OTP_RESEND_COOLDOWN_SECONDS=60
# Lifetime of the single-use token handed out after a correct OTP.
RESET_TOKEN_TTL_MINUTES=10

# --- Email -----------------------------------------------------------------
# "mock"  prints the OTP to the server log (development only)
# "smtp"  sends a real message
# "gmail" reserved for a Gmail API client; not implemented yet
#
# The app refuses to boot with EMAIL_PROVIDER=mock when ENVIRONMENT=production,
# because that log line is a live credential.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@careverse.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Supply through your environment or a secrets manager. Never commit a value.
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=15
